{
  "manifest_version": 3,
  "name": "ZHL Productivity Pack",
  "short_name": "ZHL Pack",
  "version": "1.9.0",
  "description": "Productivity helpers for Zillow Home Loans staff: VA Calc, 2-1 Buydown, Caller ID, SMS shortcuts, VPA email, and Gmail tweaks.",
  "author": "Justin Case",
  "homepage_url": "https://github.com/case2392/zhlextensions",
  "key": "",
  "oauth2": {
    "client_id": "1011825810028-avqrc6uicjtsm313eqad5ip58r7a31fq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.compose",
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  },
  "permissions": [
    "storage",
    "cookies",
    "scripting",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://operator.zillowhomeloans.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.salesforce-experience.com/*",
    "https://*.visualforce.com/*",
    "https://*.vf.force.com/*",
    "https://*.visual.force.com/*",
    "https://*.cloudforce.com/*",
    "https://apps.mypurecloud.com/*",
    "https://*.mypurecloud.com/*",
    "https://*.mypurecloud.ie/*",
    "https://*.mypurecloud.de/*",
    "https://*.mypurecloud.com.au/*",
    "https://*.mypurecloud.jp/*",
    "https://*.pure.cloud/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ZHL Productivity Pack — Setup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*"
      ],
      "js": ["inject-open-shadow.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["modules/gmail-tweaks.js"],
      "css": ["modules/gmail-tweaks.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.lightning.force.com/*"],
      "js": ["modules/salesforce-promotions.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*"
      ],
      "js": ["modules/contact-sms.js"],
      "css": ["modules/contact-sms.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*"
      ],
      "js": ["modules/sms-add-participants.js"],
      "css": ["modules/sms-add-participants.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.lightning.force.com/*"],
      "js": ["modules/auto-call-details-tab.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.lightning.force.com/*"],
      "js": ["modules/auto-messaging-tab.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://operator.zillowhomeloans.com/loan-officer-portal/*"],
      "js": ["modules/loan-amount.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://operator.zillowhomeloans.com/*"],
      "js": ["modules/va-calc.js"],
      "css": ["modules/va-calc.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://operator.zillowhomeloans.com/loan-officer-portal/*"],
      "js": ["modules/buydown-calc.js"],
      "css": ["modules/buydown-calc.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://operator.zillowhomeloans.com/loan-officer-portal/*"],
      "js": ["modules/scenario-sort.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*",
        "https://*.visual.force.com/*",
        "https://*.cloudforce.com/*",
        "https://apps.mypurecloud.com/*",
        "https://*.mypurecloud.com/*",
        "https://*.mypurecloud.ie/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.jp/*",
        "https://*.pure.cloud/*"
      ],
      "js": ["modules/caller-id.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*"
      ],
      "js": ["modules/sfgmail.js"],
      "css": ["modules/sfgmail.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
